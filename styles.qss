/*
   Dual Pane File Manager - Theme Template
   Colors are dynamically loaded from theme.json
*/

/* Global Styles - VS Code Inspired */
QWidget {
    background-color: {{bg}};
    color: {{text}};
    font-family: 'Segoe UI', 'Microsoft JhengHei', sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog, QMessageBox {
    background-color: {{bg}};
    color: {{text}};
}

QToolBar {
    background-color: {{headerBg}};
    border: none;
    padding: 2px;
    spacing: 5px;
}

QToolButton {
    background-color: {{panelBg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 12px;
    padding: 4px 12px;
}

QToolButton:hover {
    background-color: {{activeTab}};
    color: #ffffff;
}

QToolButton:pressed {
    background-color: {{border}};
}

/* 自訂路徑按鈕：HoverButton(QPushButton) 統一為 QToolButton 樣式 */
QPushButton#pathTriggerBtn {
    background-color: {{panelBg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 12px;
    padding: 4px 12px;
    min-width: 0;
}

QPushButton#pathTriggerBtn:hover {
    background-color: {{activeTab}};
    color: #ffffff;
}

QPushButton#pathTriggerBtn:pressed {
    background-color: {{border}};
}

/* Tabs - VS Code Style */
QTabWidget::pane {
    border-top: 1px solid {{border}};
    background-color: {{bg}};
}

QTabBar::tab {
    background-color: {{inactiveTab}};
    color: {{textMuted}};
    padding: 6px 10px 6px 15px;
    padding-right: 32px;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    margin-top: 2px;
    min-width: 120px; /* 確保標籤寬度夠長，不被過度擠壓 */
}

QTabBar::tab:hover {
    background-color: {{panelBg}};
    color: {{text}};
}

/* Explorer Pane Frame Focus */
ExplorerPane {
    border: 2px solid transparent;
    border-radius: 8px;
    margin: 2px;
}

ExplorerPane#inactivePane {
    border: 2px solid {{border}};
    border-radius: 8px;
}

ExplorerPane#activePane {
    border: 2px solid {{activeBorder}};
    border-radius: 8px;
}

SearchPanel#inactivePane {
    border: 2px solid {{border}};
    border-radius: 8px;
}

SearchPanel#activePane {
    border: 2px solid {{activeBorder}};
    border-radius: 8px;
}

QTabBar::tab:selected {
    background-color: {{panelBg}};
    color: {{accent}};
    font-weight: bold;
    border: none;
    border-top: 3px solid {{accent}};
    border-bottom: none;
    margin-top: 0px;
}

/* Tab Close Button - 改用實體 SVG 檔案確保渲染相容性 */
QTabBar::close-button {
    background-color: transparent;
    subcontrol-position: right;
    margin-right: 8px;   /* 離右側適中距離 */
    margin-top: 1px;     /* 因應標籤高度調降，微調對齊 */
    width: 14px;         /* 強制寬度防止被擠壓 */
    height: 14px;        /* 強制高度 */
    image: url("ui/close_normal.svg");
}

QTabBar::close-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    image: url("ui/close_hover.svg");
}

/* Tree & List Views - 徹底禁用系統雜訊 */
QTreeView, QListView, QTableWidget {
    background-color: {{bg}};
    border: none;
    outline: none; /* 移除橘色/藍色聚焦框 */
    selection-background-color: transparent;
    selection-color: transparent;
    alternate-background-color: {{panelBg}};
    show-decoration-selected: 1;
}

QTreeView::item, QListView::item {
    padding: 6px;
    color: {{text}};
    border: 1px solid transparent; 
    outline: none;
}

/* 1. 滑鼠指到的時候 (Hover) */
QTreeView::item:hover, QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

/* 2. 當此窗格是「啟動狀態 (Active Pane)」時的選取色彩 - 增亮處理 */
ExplorerPane#activePane QTreeView::item:selected,
ExplorerPane#activePane QListView::item:selected {
    background-color: {{accentSubtle}};
    border: 1px solid {{accentBorder}};
    border-radius: 6px;
    color: {{text}};
}

/* 3. 當選取了檔案，但點擊了「另一側窗格 (Inactive Pane)」時 */
ExplorerPane#inactivePane QTreeView::item:selected,
ExplorerPane#inactivePane QListView::item:selected {
    background-color: {{surfaceSubtle}};
    border: 1px solid {{border}};
    border-radius: 6px;
    color: {{textMuted}};
}

/* 4. 徹底修正：不准出現儲存格級別的橘色框 */
QTreeView:focus, QListView:focus {
    outline: none;
    border: none;
}

/* 整體窗格的啟動狀態外框 - 改為橘色 (Active) */
ExplorerPane#activePane {
    border: 1.5px solid #D97706;
}

/* Header */
QHeaderView::section {
    background-color: {{headerBg}};
    color: {{textMuted}};
    padding: 4px;
    border: none;
    border-right: 1px solid {{border}};
}

/* Splitters */
QSplitter::handle {
    background-color: {{headerBg}};
}

#mainSplitter::handle {
    background-color: {{border}};
    width: 6px;
}

#mainSplitter::handle:hover,
#mainSplitter::handle:pressed {
    background-color: {{accentSubtle}};
}

/* Input Fields */
QLineEdit, QDateEdit, QComboBox {
    background-color: {{panelBg}};
    color: {{text}};
    border: 1px solid {{border}};
    padding: 4px 8px;
    border-radius: 2px;
}

QSpinBox {
    background-color: {{panelBg}};
    color: {{text}};
    border: 1px solid {{border}};
    padding: 4px 22px 4px 8px;
    border-radius: 2px;
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background-color: {{panelBg}};
    border-left: 1px solid {{border}};
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid {{border}};
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: {{activeTab}};
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: {{border}};
}

QSpinBox::up-arrow {
    image: url(ui/spin_up.svg);
    width: 8px;
    height: 5px;
}

QSpinBox::down-arrow {
    image: url(ui/spin_down.svg);
    width: 8px;
    height: 5px;
}

QLineEdit:focus {
    border: 1px solid {{activeBorder}};
}

QGroupBox {
    border: 1px solid {{border}};
    border-radius: 5px;
    margin-top: 1.2em;   /* 為標題留下空間，防止蓋住內部文字 */
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 2px;            /* 微調垂直位置 */
    padding: 0 5px;
    color: {{accent}};
}

/* Buttons */
QPushButton {
    background-color: {{headerBg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 12px;
    padding: 6px 15px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: {{panelBg}};
}

QPushButton:pressed {
    background-color: {{accent}};
}

QPushButton[active="true"] {
    background-color: {{accent}};
    color: #ffffff;
}


/* Status Bar */
QStatusBar {
    background-color: {{headerBg}};
    color: {{text}};
    border-top: 1px solid {{border}};
}

QStatusBar QLabel {
    color: {{text}};
}

/* Context Menu */
QMenu {
    background-color: {{panelBg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
    margin: 1px 4px;
}
QMenu::item:selected {
    background-color: {{accent}};
    color: #ffffff;
}
QMenu::item:disabled {
    color: {{textMuted}};
}
QMenu::separator {
    height: 1px;
    background: {{border}};
    margin: 4px 8px;
}

/* ScrollBars — 透明軌道 + 內縮圓角滑塊 */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px 0px;
}
QScrollBar::handle:vertical {
    background: {{border}};
    min-height: 28px;
    border-radius: 4px;
    margin: 0px 2px;
}
QScrollBar::handle:vertical:hover {
    background: #525C67;
}
QScrollBar::handle:vertical:pressed {
    background: {{accent}};
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px 2px;
}
QScrollBar::handle:horizontal {
    background: {{border}};
    min-width: 28px;
    border-radius: 4px;
    margin: 2px 0px;
}
QScrollBar::handle:horizontal:hover {
    background: #525C67;
}
QScrollBar::handle:horizontal:pressed {
    background: {{accent}};
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* Path Popup Window */
#PathPopup {
    background-color: {{panelBg}};
    border: 1px solid {{border}};
    border-radius: 6px;
}

#PathPopup QPushButton:hover {
    background-color: {{inactiveTab}};
    color: {{text}};
}

/* Snapshot Button */
QToolButton#snapshotBtn {
    background-color: {{panelBg}};
    color: {{text}};
    font-size: 9.5pt;
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 2px 8px;
}

QToolButton#snapshotBtn:hover {
    background-color: {{accent}};
    color: #ffffff;
    border-color: {{accent}};
}

/* Pin Button */
QToolButton#pinBtn {
    background-color: {{panelBg}};
    color: {{activeBorder}};
    font-size: 9.5pt;
    border: 1px solid {{activeBorder}};
    border-radius: 4px;
    padding: 2px 8px;
}

QToolButton#pinBtn:hover {
    background-color: {{activeBorder}};
    color: #ffffff;
    border-color: {{activeBorder}};
}


QToolButton#pinBtnDrop {
    background-color: {{success}};
    color: #ffffff;
    font-weight: bold;
    border: 2px solid {{success}};
    border-radius: 4px;
    padding: 2px 8px;
}

/* Pin Popup */
QFrame#PinPopup {
    background-color: {{panelBg}};
    border: 1px solid {{border}};
    border-radius: 6px;
}

QPushButton#pinItemBtn {
    background-color: transparent;
    color: {{text}};
    text-align: left;
    border: none;
    padding: 4px 6px;
    font-size: 10.5pt;
}

QPushButton#pinItemBtn:hover {
    background-color: {{activeTab}};
    border-radius: 3px;
}


QPushButton#pinStar {
    background-color: transparent;
    color: {{textMuted}};
    border: none;
    padding: 0px;
    font-size: 11pt;
}

QPushButton#pinStarActive {
    background-color: transparent;
    color: {{folder}};
    border: none;
    padding: 0px;
    font-size: 11pt;
}

QLabel#pinNoteLabel {
    color: rgba(139, 148, 158, 0.6);
    font-size: 9.5pt;
    padding: 0px 6px 3px 28px;
}

QLabel#pinEmptyLabel {
    color: {{textMuted}};
    padding: 6px;
    font-size: 10pt;
}


/* Tab Plus Button */
QToolButton#addTabBtn {
    background-color: {{panelBg}};
    color: {{text}};
    font-size: 14px;
    font-weight: bold;
    border: 1px solid {{border}};
    border-radius: 12px; /* 同步工具列按鍵圓角 */
    padding: 2px 8px;    /* 縮小尺寸 */
}

QToolButton#addTabBtn:hover {
    background-color: {{activeTab}};
    color: #ffffff;
}

/* Tab Scroller Buttons Styles */
QTabBar QToolButton {
    background-color: {{headerBg}};
    border: 1px solid {{accent}}; /* 用強調色框起來，更容易看見 */
    border-radius: 4px;
    width: 22px;
    height: 22px;
    margin: 1px;
}

QTabBar QToolButton:hover {
    background-color: {{activeTab}};
}

QTabBar QToolButton::right-arrow {
    image: url("ui/right_arrow.svg");
    width: 12px;
    height: 12px;
}

QTabBar QToolButton::left-arrow {
    image: url("ui/left_arrow.svg");
    width: 12px;
    height: 12px;
}

/* In-time Message Label */
#msgLabel {
    color: {{textMuted}};
    font-size: 9.5pt;
    padding: 0 15px;
    margin-left: 10px;
}

#msgLabel[type="error"] {
    color: #F85149; /* 更沉穩的 GitHub 紅 */
    background-color: rgba(248, 81, 73, 0.05);
    border-radius: 4px;
}

#msgLabel[type="tip"] {
    color: {{text}};
}

#msgLabel[flash="true"] {
    color: #ffffff;
    background-color: {{accent}};
    border-radius: 4px;
    font-weight: bold;
}

QPushButton#syncMirrorBtn {
    background-color: {{danger}};
    color: #ffffff;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton#syncMirrorBtn:hover {
    background-color: {{danger}};
    opacity: 0.85;
}
QPushButton#syncMirrorBtn:disabled {
    background-color: {{border}};
    color: {{textMuted}};
}

QPushButton#syncL2RBtn {
    background-color: {{accent}};
    color: #ffffff;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 12px;
}
QPushButton#syncL2RBtn:hover {
    background-color: {{activeTab}};
}
QPushButton#syncL2RBtn:disabled {
    background-color: {{border}};
    color: {{textMuted}};
}

#paneStatusLabel {
    color: {{textMuted}};
    font-size: 9.5pt;
    padding: 0 8px;
}

/* --- 狀態列垃圾桶按鈕 --- */
QToolButton#trashDropBtn {
    background-color: transparent;
    border: none;
    border-right: 1px solid {{border}};
    padding: 4px 10px;
}

QToolButton#trashDropBtn:hover {
    background-color: rgba(224, 108, 117, 0.15);
    border-right: 1px solid {{border}};
}

QToolButton#trashDropBtnDrag {
    background-color: rgba(224, 108, 117, 0.30);
    border: 1px solid rgba(224, 108, 117, 0.6);
    border-radius: 4px;
    padding: 4px 10px;
}

/* --- Temporary Trash (臨時垃圾桶) --- */
#trashWidget {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}

#trashWidget[active="true"] {
    border: 1px solid {{accent}};
    background-color: {{inactiveTab}};
}

#trashWidget:hover {
    border: 1px solid {{border}};
    background-color: {{inactiveTab}};
}

#trashIcon {
    font-size: 18pt;
}

#trashBadge {
    background-color: #f85149;
    color: white;
    border-radius: 10px;
    padding: 0px;
    font-size: 8pt;
    font-weight: bold;
    min-width: 20px;
    min-height: 20px;
}

/* --- 導覽窗格 (Navigation Pane) --- */
#navPanel {
    background-color: {{panelBg}};
    border-right: 1px solid {{border}};
}

#navTree {
    background-color: {{panelBg}};
    border: none;
}

#navTree::item {
    padding: 5px 4px;
    color: {{text}};
}

#navTree::item:hover {
    background-color: {{inactiveTab}};
}

#navTree::item:selected {
    background-color: {{activeTab}};
    color: #ffffff;
}

/* --- Same-path Warning Bar --- */
#samePathWarning {
    background-color: {{accentSubtle}};
    color: {{text}};
    font-size: 9pt;
    padding: 3px 0;
    border-top: 1px solid {{accentBorder}};
    border-bottom: 1px solid {{accentBorder}};
}

/* --- Toast Notifications --- */
Toast {
    background-color: {{panelBg}};
    border: 1px solid {{border}};
    border-radius: 8px;
    min-width: 240px;
    max-width: 380px;
}
Toast[kind="success"] { border-left: 4px solid {{success}}; }
Toast[kind="error"]   { border-left: 4px solid {{danger}}; }
Toast[kind="info"]    { border-left: 4px solid {{accent}}; }
Toast[kind="warning"] { border-left: 4px solid {{folder}}; }

#toastIcon {
    font-size: 12pt;
    font-weight: bold;
}
#toastMsg {
    color: {{text}};
    font-size: 9.5pt;
}
#toastClose {
    background: transparent;
    border: none;
    color: {{textMuted}};
    font-size: 9pt;
    padding: 0;
}
#toastClose:hover {
    color: {{text}};
}


/* Preview Mode Close Button */
QToolButton#closePreviewBtn {
    background-color: {{danger}};
    color: #ffffff;
    font-size: 9pt;
    font-weight: bold;
    border: 1px solid {{danger}};
    border-radius: 4px;
    padding: 2px 10px;
}
QToolButton#closePreviewBtn:hover {
    background-color: {{accent}};
    border-color: {{accent}};
}

/* Quality Toggle Button (Glassmorphism) */
QToolButton#qualityToggleBtn {
    background-color: transparent;
    border-radius: 4px;
    font-size: 10pt;
    font-weight: normal;
    padding: 3px 12px;
}

QToolButton#qualityToggleBtn[quality="SD"] {
    border: 1px solid #4A4D55;
    color: #B0B3B8;
    qproperty-icon: url("ui/bolt.svg");
}

QToolButton#qualityToggleBtn[quality="SD"]:hover {
    border: 1px solid #6A6D75;
    color: #FFFFFF;
    qproperty-icon: url("ui/bolt_hover.svg");
    background-color: rgba(255, 255, 255, 0.05);
}

QToolButton#qualityToggleBtn[quality="HD"] {
    border: 1px solid #1F4068;
    color: #3b82f6;
    qproperty-icon: url("ui/monitor_up.svg");
    background-color: rgba(31, 64, 104, 0.3);
}

QToolButton#qualityToggleBtn[quality="HD"]:hover {
    border: 1px solid #3b82f6;
    color: #60A5FA;
    qproperty-icon: url("ui/monitor_up_hover.svg");
    background-color: rgba(59, 130, 246, 0.15);
}

/* Pane header icon-only buttons */
QToolButton#backBtn,
QToolButton#forwardBtn,
QToolButton#upBtn,
QToolButton#paneHomeBtn,
QToolButton#paneCustomPathsBtn,
QToolButton#listViewBtn,
QToolButton#gridViewBtn,
QToolButton#advSearchBtn {
    padding: 4px; /* 增加到 4px，讓 16px 圖示在 24px 按鈕中更通透 */
    min-width: 24px;
    min-height: 24px;
    border-radius: 6px;
}

QToolButton#backBtn        { image: url(ui/left_arrow.svg); }
QToolButton#forwardBtn     { image: url(ui/right_arrow.svg); }
QToolButton#upBtn          { image: url(ui/up_arrow.svg); }
QToolButton#paneHomeBtn    { image: url(ui/home.svg); }
QToolButton#paneCustomPathsBtn { image: url(ui/star.svg); }
QToolButton#listViewBtn    { image: url(ui/list_view.svg); }
QToolButton#gridViewBtn    { image: url(ui/grid_view.svg); }
QToolButton#advSearchBtn   { image: url(ui/filter.svg); }

/* Disabled state — dimmed gray icons */
QToolButton#backBtn:disabled    { image: url(ui/left_arrow_disabled.svg); }
QToolButton#forwardBtn:disabled { image: url(ui/right_arrow_disabled.svg); }

QToolButton#listViewBtn[active="true"],
QToolButton#gridViewBtn[active="true"] {
    background-color: rgba(88, 166, 255, 0.15);
    border-color: rgba(88, 166, 255, 0.5);
}
QToolButton#listViewBtn[active="true"] {
    image: url(ui/list_view_active.svg);
}
QToolButton#gridViewBtn[active="true"] {
    image: url(ui/grid_view_active.svg);
}

/* ── 過濾抽屜 ────────────────────────────────────────────────── */
QFrame#filterDrawer {
    background-color: {{panelBg}};
    border-top: 1px solid {{border}};
    border-bottom: 1px solid {{border}};
}

QFrame#filterDrawer QLabel {
    color: #9ca3af;
    font-size: 10pt;
    min-width: 32px;
}

QPushButton#filterChipBtn {
    background-color: transparent;
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 9pt;
}

QPushButton#filterChipBtn:hover {
    background-color: {{activeTab}};
    color: #ffffff;
}

QPushButton#filterChipBtn:checked {
    background-color: {{activeTab}};
    color: #ffffff;
    border-color: {{activeTab}};
}

QPushButton#deepSearchLink {
    color: #4a90d9;
    background-color: transparent;
    border: none;
    padding: 0px 2px;
    font-size: 9pt;
    text-align: left;
}

QPushButton#deepSearchLink:hover {
    color: #6ab0f5;
    text-decoration: underline;
}

/* advSearchBtn 啟用（抽屜展開）狀態 */
QToolButton#advSearchBtn:checked {
    background-color: rgba(88, 166, 255, 0.15);
    border-color: rgba(88, 166, 255, 0.5);
}
/* ────────────────────────────────────────────────────────────── */

/* ── 平面搜尋結果視圖（Everything 風格）──────────────────────── */
QTreeView#flatResultView {
    background-color: {{bg}};
    color: {{text}};
    border: none;
    alternate-background-color: {{panelBg}};
}
QTreeView#flatResultView::item {
    padding: 3px 6px;
    border: none;
}
QTreeView#flatResultView::item:selected {
    background-color: {{activeTab}};
    color: #ffffff;
}
QTreeView#flatResultView::item:hover {
    background-color: {{accentSubtle}};
}
QTreeView#flatResultView QHeaderView::section {
    background-color: {{headerBg}};
    color: {{text}};
    border: none;
    border-right: 1px solid {{border}};
    padding: 4px 6px;
}
/* ────────────────────────────────────────────────────────────── */

/* Search input with left icon (icon added via code addAction) */
QLineEdit#searchEdit {
    padding-left: 5px;
    padding-right: 5px;
}

/* 搜尋欄下方即時計數與提示標籤 */
QLabel#searchStatusLabel {
    color: #9ca3af;
    font-size: 11px;
    padding: 1px 6px 2px 6px;
}


QSplitter#mainSplitter::handle {
    background: transparent;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: {{panelBg}};
    border: 1px solid {{border}};
    border-radius: 4px;
    text-align: center;
    color: {{text}};
    font-size: 10px;
}

QProgressBar::chunk {
    background-color: {{accent}};
    border-radius: 3px;
}

QProgressBar#scan_progress_bar {
    background-color: transparent;
    border: none;
}
QProgressBar#scan_progress_bar::chunk {
    background-color: {{accentSubtle}};
}

/* --- CheckBoxes & RadioButtons --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: {{text}};
    outline: none;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background-color: {{panelBg}};
    border: 1.5px solid {{border}}; /* 加粗邊框提高辨識度 */
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: {{accent}};
    background-color: rgba(88, 166, 255, 0.05);
}

QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
    image: url("ui/check_active.svg");
}

QCheckBox::indicator:unchecked {
    border: 1.5px solid {{border}};
}

QRadioButton::indicator {
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
    image: url("ui/check_active.svg");
}

QCheckBox:disabled, QRadioButton:disabled {
    color: {{textMuted}};
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: {{border}};
    background-color: {{bg}};
    opacity: 0.5;
}

/* Preview edit bar */
QWidget#previewEditBar {
    background-color: {{headerBg}};
    border-bottom: 1px solid {{border}};
}

QWidget#previewEditBar QPushButton {
    padding: 2px 10px;
    font-size: 11px;
    border-radius: 3px;
}

QWidget#previewEditBar QPushButton#editSaveBtn {
    color: {{accent}};
    border: 1px solid {{accent}};
}

QWidget#previewEditBar QPushButton#editSaveBtn:hover {
    background-color: {{accentSubtle}};
}

QWidget#previewEditBar QPushButton#editDiscardBtn {
    color: {{textMuted}};
}

/* ── Command Palette ─────────────────────────────────────────────────────── */

QFrame#cmdPaletteFrame {
    background-color: {{glassBg}};
    border: 1px solid {{glassBorder}};
    border-radius: 10px;
}

QLineEdit#cmdPaletteInput {
    background-color: {{panelBg}};
    border: 1px solid {{accentBorder}};
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12pt;
    color: {{text}};
    selection-background-color: {{accentSubtle}};
}

QListWidget#cmdPaletteList {
    background: transparent;
    border: none;
    outline: 0;
    margin-top: 2px;
}

QListWidget#cmdPaletteList::item {
    border-radius: 4px;
    margin: 1px 0;
}

QListWidget#cmdPaletteList::item:selected {
    background-color: {{accentSubtle}};
    border: 1px solid {{accentBorder}};
    outline: 0;
}

QListWidget#cmdPaletteList::item:hover:!selected {
    background-color: {{surfaceSubtle}};
}

QWidget#cmdRow {
    background: transparent;
}

QLabel#cmdCat {
    color: {{folder}};
    font-size: 9pt;
}

QLabel#cmdTitle {
    color: {{text}};
    font-size: 10pt;
}

QLabel#cmdSc {
    color: {{textMuted}};
    font-size: 9pt;
}

